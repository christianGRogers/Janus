[Unit]
Description=Janus Financial Inference Broker with LXD Container Queue
Documentation=https://github.com/christianGRogers/Janus
After=network.target lxd.service
Wants=lxd.service

[Service]
Type=notify
User=janus
Group=janus
WorkingDirectory=/opt/janus

# Environment variables for LXD container queue
Environment="LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket"
Environment="LXD_IMAGE_NAME=janus-compute-node"
Environment="CONTAINER_QUEUE_SIZE=5"
Environment="CONTAINER_PROVISION_DELAY=2"
Environment="CONTAINER_READY_TIMEOUT=60"
Environment="JANUS_MODEL_DIR=/opt/janus/models"
Environment="PYTHONUNBUFFERED=1"

# Start command
ExecStart=/opt/janus/venv/bin/uvicorn \
  janus.server.app:app \
  --host 0.0.0.0 \
  --port 8000 \
  --workers 1 \
  --log-level info

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Resource limits
MemoryLimit=4G
CPUQuota=200%

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/janus/models /opt/janus/logs /var/snap/lxd/common/lxd/unix.socket

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=janus

[Install]
WantedBy=multi-user.target
